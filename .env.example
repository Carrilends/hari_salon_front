# Fase 3b: la API se sirve bajo el propio origen del frontend (proxy de Quasar
# en dev, de Netlify en prod) para que la cookie de sesion sea de primera parte.
# En dev, el proxy apunta a DEV_API_TARGET (default http://localhost:3001).
VITE_API_URL=/api
# URL absoluta del sitio (sin trailing slash). Usado para canonical, OG y sitemap.
# El sufijo "pecas" es el nombre del sitio en Netlify y se mantiene de forma
# deliberada; no es un resto del branding anterior de la peluqueria.
VITE_SITE_URL=https://peluqueria-marlene-pecas.netlify.app

# Fase 3b: client id de Google Identity Services (publico, viaja al navegador).
# Se crea en Google Cloud Console (OAuth Client ID tipo Aplicacion web).
VITE_GOOGLE_CLIENT_ID=CHANGE_ME

# Fase 4: URL del WebSocket del panel. Apunta DIRECTO al backend (Railway en
# prod), no al proxy, porque el proxy no negocia el Upgrade del socket (N4).
# En dev: http://localhost:3001. En prod: la URL publica de la API en Railway.
VITE_WS_URL=http://localhost:3001

# Telefono del click-to-chat (wa.me y tel:), en E.164 SIN signos ni espacios.
# Es el numero propio de Marlene, no la linea dedicada de la Cloud API (esa vive
# en el backend). OPCIONAL: si se deja vacia o sin definir se usa el numero del
# negocio que guarda src/constants/salon-location.ts.
VITE_WHATSAPP_PHONE=573208977471
